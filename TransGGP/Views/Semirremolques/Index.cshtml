@using TransGGP.Application.Security
@model List<TransGGP.Domain.Models.Semirremolque>
@{
    var puedeEditar = User.TienePermiso(Permisos.SemirremolquesEditar);
}

<h1>Semirremolques</h1>

@if (puedeEditar)
{
    <a asp-action="Create" class="btn btn-primary mb-3">+ Nuevo semirremolque</a>
}

@if (!Model.Any())
{
    <p class="text-muted">Aún no hay semirremolques registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Clave</th>
                <th>Placa</th>
                <th>Tipo</th>
                <th>Fecha de creación</th>
                @if (puedeEditar)
                {
                    <th>Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.Clave</td>
                    <td>@s.Placa</td>
                    <td>@s.Tipo</td>
                    <td>@s.FechaCreacion.ToString("dd/MM/yyyy")</td>
                    @if (puedeEditar)
                    {
                        <td>
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-primary btn-sm">Editar</a>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar este semirremolque?');" style="display:inline;">
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
