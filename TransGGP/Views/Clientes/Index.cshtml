@using TransGGP.Application.Security
@model List<TransGGP.Domain.Models.Cliente>
@{
    var puedeEditar = User.TienePermiso(Permisos.ClientesEditar);
}

<h1>Clientes</h1>

@if (puedeEditar)
{
    <a asp-action="Create" class="btn btn-primary mb-3">+ Nuevo cliente</a>
}
<a asp-action="Reporte" class="btn btn-outline-secondary mb-3">Reporte PDF</a>

@if (!Model.Any())
{
    <p class="text-muted">Aún no hay clientes registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Fecha de creación</th>
                @if (puedeEditar)
                {
                    <th>Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.Id</td>
                    <td>@cliente.Nombre</td>
                    <td>@cliente.FechaCreacion.ToString("dd/MM/yyyy")</td>
                    @if (puedeEditar)
                    {
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-warning btn-sm">Editar</a>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar este cliente?');">
                                    <input type="hidden" name="id" value="@cliente.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
