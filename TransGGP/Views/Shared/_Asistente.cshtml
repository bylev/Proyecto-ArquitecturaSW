@Html.AntiForgeryToken()

<div id="ggpChat" class="ggp-chat">
    <button id="ggpChatToggle" class="ggp-chat-toggle" type="button" aria-label="Abrir asistente">
        <svg class="ggp-chat-icon-open" viewBox="0 0 24 24" width="27" height="27" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <svg class="ggp-chat-icon-close" viewBox="0 0 24 24" width="27" height="27" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>

    <div id="ggpChatPanel" class="ggp-chat-panel" aria-hidden="true">
        <div class="ggp-chat-header">
            <div class="ggp-chat-title">
                <span class="ggp-chat-dot"></span>
                <div>
                    <strong>Transpi</strong>
                    <small>Tu asistente de análisis</small>
                </div>
            </div>
        </div>

        <div id="ggpChatMensajes" class="ggp-chat-body">
            <div class="ggp-chat-intro">
                <div class="ggp-mascota">
                    <svg viewBox="0 0 120 120" width="104" height="104" aria-hidden="true">
                        <ellipse cx="60" cy="108" rx="34" ry="6" fill="#1C3D73" opacity=".13" />
                        <g class="m-body">
                            <rect x="26" y="44" width="56" height="40" rx="12" fill="#1C3D73" />
                            <rect x="78" y="56" width="20" height="28" rx="7" fill="#3A63A8" />
                            <rect x="34" y="54" width="38" height="22" rx="7" fill="#F5B921" />
                            <circle cx="46" cy="65" r="4.6" fill="#102A52" class="m-eye" />
                            <circle cx="61" cy="65" r="4.6" fill="#102A52" class="m-eye" />
                            <circle cx="41" cy="90" r="9" fill="#102A52" />
                            <circle cx="41" cy="90" r="3.6" fill="#DCE5F3" />
                            <circle cx="79" cy="90" r="9" fill="#102A52" />
                            <circle cx="79" cy="90" r="3.6" fill="#DCE5F3" />
                            <line x1="54" y1="44" x2="54" y2="30" stroke="#3A63A8" stroke-width="3.4" stroke-linecap="round" />
                            <circle cx="54" cy="26" r="5.4" fill="#F5B921" class="m-antena" />
                        </g>
                    </svg>
                </div>
                <p class="ggp-chat-hola">Hola, soy <b>Transpi</b>.</p>
                <p class="ggp-chat-desc">Analizo los datos de tu panel y te digo cómo va el negocio. Pregúntame lo que quieras.</p>
                <div class="ggp-sugerencias">
                    <button type="button" class="ggp-sug">¿Cómo va mi empresa este año?</button>
                    <button type="button" class="ggp-sug">¿Cuáles fueron los meses más bajos?</button>
                    <button type="button" class="ggp-sug">Dame recomendaciones para crecer</button>
                </div>
            </div>
        </div>

        <form id="ggpChatForm" class="ggp-chat-input">
            <input id="ggpChatTexto" type="text" autocomplete="off" placeholder="Escribe tu pregunta…" maxlength="500" />
            <button type="submit" aria-label="Enviar">
                <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </form>
    </div>
</div>

<script src="~/js/asistente.js" asp-append-version="true"></script>
