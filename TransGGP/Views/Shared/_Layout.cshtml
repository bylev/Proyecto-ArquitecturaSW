@{
    var controladorActual = ViewContext.RouteData.Values["Controller"]?.ToString();
    var accionActual = ViewContext.RouteData.Values["Action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Transportes GGP</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TransGGP.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" height="55" alt="Transportes GGP" class="me-2" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark @(controladorActual == "Home" && accionActual == "Index" ? "active fw-bold" : "")" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @(controladorActual == "Servicios" ? "active fw-bold" : "")" asp-area="" asp-controller="Servicios" asp-action="Index">Servicios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(controladorActual == "Clientes" ? "active fw-bold" : "")" asp-area="" asp-controller="Clientes" asp-action="Index">Clientes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(controladorActual == "Operadores" ? "active fw-bold" : "")" asp-area="" asp-controller="Operadores" asp-action="Index">Operadores</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(controladorActual == "Unidades" ? "active fw-bold" : "")" asp-area="" asp-controller="Unidades" asp-action="Index">Unidades</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(controladorActual == "Semirremolques" ? "active fw-bold" : "")" asp-area="" asp-controller="Semirremolques" asp-action="Index">Semirremolques</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(controladorActual == "Dollys" ? "active fw-bold" : "")" asp-area="" asp-controller="Dollys" asp-action="Index">Dollys</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(controladorActual == "Configuraciones" ? "active fw-bold" : "")" asp-area="" asp-controller="Configuraciones" asp-action="Index">Configuraciones</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark @(controladorActual == "Home" && accionActual == "Privacy" ? "active fw-bold" : "")" asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="nav-link text-dark">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item d-flex align-items-center">
                                <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Salir</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark @(controladorActual == "Cuenta" ? "active fw-bold" : "")" asp-controller="Cuenta" asp-action="Login">Entrar</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success">@TempData["Exito"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-warning">@TempData["Error"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TransGGP - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
