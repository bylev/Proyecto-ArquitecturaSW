@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <h1 class="text-danger">Algo salió mal</h1>
    <p class="lead">Ocurrió un error al procesar tu solicitud. Por favor, inténtalo de nuevo.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            <small>Código de referencia: <code>@Model.RequestId</code></small>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Volver al inicio</a>
</div>
