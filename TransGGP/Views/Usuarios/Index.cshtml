@using System.Security.Claims
@model List<TransGGP.Domain.Models.Usuario>

@{
    var idUsuarioActualTexto = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(idUsuarioActualTexto, out var idUsuarioActual);
    var emailUsuarioActual = User.FindFirst(ClaimTypes.Email)?.Value;
}

<h1>Usuarios</h1>

<a asp-action="Create" class="btn btn-primary mb-3">+ Nuevo usuario</a>

@if (!Model.Any())
{
    <p class="text-muted">Aún no hay usuarios registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Fecha de creación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                var esUsuarioActual = idUsuarioActual == u.Id
                    || string.Equals(emailUsuarioActual, u.Email, StringComparison.OrdinalIgnoreCase);

                <tr>
                    <td>@u.Id</td>
                    <td>@u.NombreCompleto</td>
                    <td>@u.Email</td>
                    <td>@u.Rol</td>
                    <td>@u.FechaCreacion.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <form asp-action="CambiarRol" method="post" class="d-flex gap-2 align-items-center">
                                <input type="hidden" name="id" value="@u.Id" />
                                <select name="rol" class="form-select form-select-sm" disabled="@esUsuarioActual">
                                    <option value="Admin" selected="@(u.Rol == "Admin")">Admin</option>
                                    <option value="User" selected="@(u.Rol == "User")">User</option>
                                </select>
                                <button type="submit" class="btn btn-outline-primary btn-sm" disabled="@esUsuarioActual">
                                    Cambiar rol
                                </button>
                            </form>

                            <form asp-action="Delete" asp-route-id="@u.Id" method="post" onsubmit="return confirm('¿Seguro que quieres eliminar este usuario?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm" disabled="@esUsuarioActual">
                                    Eliminar
                                </button>
                            </form>

                            @if (!esUsuarioActual && u.Rol != "Admin")
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#permisos-@u.Id">
                                    Permisos
                                </button>
                            }

                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#password-@u.Id">
                                Restablecer contraseña
                            </button>
                        </div>

                        <div class="collapse mt-2" id="password-@u.Id">
                            <form asp-action="ResetearPassword" asp-route-id="@u.Id" method="post" class="d-flex gap-2 align-items-center" style="max-width: 420px;">
                                <input type="password" name="password" class="form-control form-control-sm" placeholder="Nueva contraseña (mínimo 6)" required minlength="6" />
                                <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                            </form>
                            <small class="text-muted">Se le asigna esta contraseña; el usuario podrá cambiarla luego desde su cuenta.</small>
                        </div>
                        @if (esUsuarioActual)
                        {
                            <small class="text-muted">Tu cuenta actual</small>
                        }

                        @if (!esUsuarioActual && u.Rol != "Admin")
                        {
                            <div class="collapse mt-2" id="permisos-@u.Id">
                                <form asp-action="ActualizarPermisos" asp-route-id="@u.Id" method="post">
                                    <table class="table table-bordered mb-2">
                                        <thead>
                                            <tr>
                                                <th>Módulo</th>
                                                <th class="text-center">Ver</th>
                                                <th class="text-center">Editar</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Servicios</td>
                                                <td class="text-center"><input type="checkbox" name="PuedeVerServicios" value="true" checked="@u.PuedeVerServicios" class="form-check-input" /></td>
                                                <td class="text-center"><input type="checkbox" name="PuedeEditarServicios" value="true" checked="@u.PuedeEditarServicios" class="form-check-input" /></td>
                                            </tr>
                                            <tr>
                                                <td>Clientes</td>
                                                <td class="text-center"><input type="checkbox" name="PuedeVerClientes" value="true" checked="@u.PuedeVerClientes" class="form-check-input" /></td>
                                                <td class="text-center"><input type="checkbox" name="PuedeEditarClientes" value="true" checked="@u.PuedeEditarClientes" class="form-check-input" /></td>
                                            </tr>
                                            <tr>
                                                <td>Operadores</td>
                                                <td class="text-center"><input type="checkbox" name="PuedeVerOperadores" value="true" checked="@u.PuedeVerOperadores" class="form-check-input" /></td>
                                                <td class="text-center"><input type="checkbox" name="PuedeEditarOperadores" value="true" checked="@u.PuedeEditarOperadores" class="form-check-input" /></td>
                                            </tr>
                                            <tr>
                                                <td>Unidades</td>
                                                <td class="text-center"><input type="checkbox" name="PuedeVerUnidades" value="true" checked="@u.PuedeVerUnidades" class="form-check-input" /></td>
                                                <td class="text-center"><input type="checkbox" name="PuedeEditarUnidades" value="true" checked="@u.PuedeEditarUnidades" class="form-check-input" /></td>
                                            </tr>
                                            <tr>
                                                <td>Semirremolques</td>
                                                <td class="text-center"><input type="checkbox" name="PuedeVerSemirremolques" value="true" checked="@u.PuedeVerSemirremolques" class="form-check-input" /></td>
                                                <td class="text-center"><input type="checkbox" name="PuedeEditarSemirremolques" value="true" checked="@u.PuedeEditarSemirremolques" class="form-check-input" /></td>
                                            </tr>
                                            <tr>
                                                <td>Dollys</td>
                                                <td class="text-center"><input type="checkbox" name="PuedeVerDollys" value="true" checked="@u.PuedeVerDollys" class="form-check-input" /></td>
                                                <td class="text-center"><input type="checkbox" name="PuedeEditarDollys" value="true" checked="@u.PuedeEditarDollys" class="form-check-input" /></td>
                                            </tr>
                                            <tr>
                                                <td>Configuraciones</td>
                                                <td class="text-center"><input type="checkbox" name="PuedeVerConfiguraciones" value="true" checked="@u.PuedeVerConfiguraciones" class="form-check-input" /></td>
                                                <td class="text-center"><input type="checkbox" name="PuedeEditarConfiguraciones" value="true" checked="@u.PuedeEditarConfiguraciones" class="form-check-input" /></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <button type="submit" class="btn btn-primary btn-sm">Guardar permisos</button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
