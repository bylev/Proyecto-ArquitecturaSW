@{
    ViewData["Title"] = "Inicio";
}

<section class="ggp-hero">
    <div class="ggp-hero-glow"></div>
    <svg class="ggp-hero-wave" viewBox="0 0 1440 400" preserveAspectRatio="none" aria-hidden="true">
        <defs>
            <linearGradient id="ggpWave" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#e6b968" />
                <stop offset=".35" stop-color="#48c0b0" />
                <stop offset=".7" stop-color="#6d7bff" />
                <stop offset="1" stop-color="#c86bd6" />
            </linearGradient>
            <filter id="ggpGlow" x="-20%" y="-60%" width="140%" height="240%">
                <feGaussianBlur stdDeviation="9" />
            </filter>
        </defs>
        <g class="ggp-wave-move">
            <path d="M-140,236 C 240,110 470,330 760,224 C 1010,132 1230,300 1580,206"
                  stroke="url(#ggpWave)" stroke-width="10" fill="none" filter="url(#ggpGlow)" opacity=".65" />
            <path d="M-140,236 C 240,110 470,330 760,224 C 1010,132 1230,300 1580,206"
                  stroke="url(#ggpWave)" stroke-width="3.5" fill="none" />
        </g>
    </svg>

    <div class="ggp-hero-content">
        <p class="ggp-hero-eyebrow">Sistema de gestión de transporte</p>
        <h1 class="ggp-hero-title"><span id="typed"></span><span class="type-cursor">|</span></h1>
        <p class="ggp-hero-sub">
            Registra y administra los servicios de transporte de carga, sus clientes,
            operadores y unidades — con un historial confiable para analizar el crecimiento del negocio.
        </p>
        <div class="ggp-hero-cta">
            <a asp-controller="Servicios" asp-action="Index" class="btn-hero-light">Registrar servicio <span class="arrow">&rarr;</span></a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn-ghost-light">Ver panel <span class="arrow">&rarr;</span></a>
        </div>
    </div>
</section>

<section class="pb-5">
    <p class="ggp-eyebrow mb-3">Explora el sistema</p>
    <div class="row g-4">
        <div class="col-6 col-md-3">
            <a asp-controller="Servicios" asp-action="Index" class="modulo-card">
                <h3>Servicios</h3>
                <p>Registro de cada viaje con su cliente, operador y unidad.</p>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Clientes" asp-action="Index" class="modulo-card">
                <h3>Clientes</h3>
                <p>Catálogo de clientes del negocio.</p>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Operadores" asp-action="Index" class="modulo-card">
                <h3>Operadores</h3>
                <p>Choferes asignados a los servicios.</p>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Unidades" asp-action="Index" class="modulo-card">
                <h3>Unidades</h3>
                <p>Tractocamiones y equipo de transporte.</p>
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var texto = "Transportes GGP";
            var destino = document.getElementById("typed");
            if (!destino) return;
            var i = 0;
            function escribir() {
                if (i <= texto.length) {
                    destino.textContent = texto.substring(0, i);
                    i++;
                    setTimeout(escribir, 105);
                }
            }
            escribir();
        })();
    </script>
}
