@using TransGGP.Application.Security
@model List<TransGGP.Domain.Models.Configuracion>
@{
    var puedeEditar = User.TienePermiso(Permisos.ConfiguracionesEditar);
}

<h1>Configuraciones</h1>

@if (puedeEditar)
{
    <a asp-action="Create" class="btn btn-primary mb-3">+ Nueva configuración</a>
}

@if (!Model.Any())
{
    <p class="text-muted">Aún no hay configuraciones registradas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                @if (puedeEditar)
                {
                    <th>Acciones</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Nombre</td>
                    @if (puedeEditar)
                    {
                        <td>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-primary btn-sm">Editar</a>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar esta configuración?');" style="display:inline;">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
